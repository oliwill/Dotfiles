{
  "enabledPlugins": {
    "glm-plan-bug@zai-coding-plugins": true,
    "glm-plan-usage@zai-coding-plugins": true
  },
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "magpie",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:3425",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "group/plan-writing",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "长文与写作 · Kimi优先",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "group/plan-fast",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "快速整理 · GLM Flash",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "group/plan-writing",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "长文与写作 · Kimi优先",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "group/plan-research",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "研究与日常 · GLM优先",
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "group/plan-research",
    "ANTHROPIC_SMALL_FAST_MODEL": "group/plan-fast",
    "CLAUDE_CODE_EFFORT_LEVEL": "high",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "256000",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "256000"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "C:/Users/Lzw/.bun/bin/bun.exe \"C:/Users/Lzw/.confirmo/hooks/confirmo-hook.js\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "C:/Users/Lzw/.bun/bin/bun.exe \"C:/Users/Lzw/.confirmo/hooks/confirmo-hook.js\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "C:/Users/Lzw/.bun/bin/bun.exe \"C:/Users/Lzw/.confirmo/hooks/confirmo-hook.js\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "C:/Users/Lzw/.bun/bin/bun.exe \"C:/Users/Lzw/.confirmo/hooks/confirmo-hook.js\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": ""
      }
