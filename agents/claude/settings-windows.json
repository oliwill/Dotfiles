    "Stop": [
      {
        "hooks": [
          {
            "command": "C:/Users/Lzw/.bun/bin/bun.exe \"C:/Users/Lzw/.confirmo/hooks/confirmo-hook.js\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "C:/Users/Lzw/.bun/bin/bun.exe \"C:/Users/Lzw/.confirmo/hooks/confirmo-hook.js\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "model": "opus"
