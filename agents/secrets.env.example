# AI Agent 密钥（复制为 ~/.config/dotfiles/secrets.env 并填入真实值，建议从 1Password 取）
# 此文件永不提交真实密钥；secrets.env 已在 .gitignore 中

# 智谱 GLM API Key（Pi / OMP / Codex 的 bigmodel MCP 服务共用）
GLM_API_KEY=

# 智谱 Anthropic 兼容端点 Token（Claude Code / Codex，Mac 使用）
ZHIPU_ANTHROPIC_TOKEN=

# utools 本地 MCP 服务密钥（Windows）
UTOOLS_MCP_KEY=

# 本地代理（127.0.0.1:15721）的 Bearer Token（Windows，cc-switch 代理）
PROXY_BEARER_TOKEN=
